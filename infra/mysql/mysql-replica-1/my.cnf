[mysqld]

server-id = 2

log_bin = mysql-bin

binlog_format = ROW
binlog_row_image = FULL

gtid_mode = ON
enforce_gtid_consistency = ON

# Replica must log updates if future cascading replicas possible
log_replica_updates = ON

read_only = ON

# Binlog retention (optional but safe)
binlog_expire_logs_seconds = 604800

# Durability settings
sync_binlog = 1
innodb_flush_log_at_trx_commit = 1

# Optional safety
skip-name-resolve